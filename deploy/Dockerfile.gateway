# Build de SignTrack.Gateway.Api para Render (sin build args, self-contained)
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY SignTrack.sln ./
COPY services/ ./services/
RUN dotnet restore SignTrack.sln
RUN dotnet publish "services/gateway/SignTrack.Gateway.Api/SignTrack.Gateway.Api.csproj" -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "SignTrack.Gateway.Api.dll"]
