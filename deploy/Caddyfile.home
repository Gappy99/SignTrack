# Caddy — SignTrack en PC de casa (Mac/Windows)
# Backend corre en el host (pnpm start-home); Caddy proxy + HTTPS + frontend estático.
# Variable: DOMAIN=signtrack-kinal.duckdns.org

{$DOMAIN} {
	encode gzip
	redir / /signtrack/ permanent

	handle /signtrack/* {
		uri strip_prefix /signtrack
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}

	handle /api/* {
		reverse_proxy host.docker.internal:5050
	}
	handle /hubs/* {
		reverse_proxy host.docker.internal:5050
	}
	handle /recognition-api/* {
		reverse_proxy host.docker.internal:5050
	}

	handle /livekit/* {
		uri strip_prefix /livekit
		reverse_proxy host.docker.internal:7880
	}
}
