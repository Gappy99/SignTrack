# SignTrack — Variables de entorno (raíz del monorepo)
#
# Copia a .env y ajusta valores. ASP.NET Core mapea __ a secciones anidadas.
# Cada servicio también puede tener su propio .env en services/<nombre>/

# ── Docker (docker-compose.yml) ──────────────────────────────────────────────
POSTGRES_DB=SignTrack
POSTGRES_USER=root
POSTGRES_PASSWORD=admin
POSTGRES_PORT=5435

REDIS_PORT=6379

# ── Gateway (:5000) ──────────────────────────────────────────────────────────
GATEWAY_URL=http://localhost:5000
ASPNETCORE_URLS__GATEWAY=http://localhost:5000

DownstreamUrls__Identity=http://localhost:5104
DownstreamUrls__Calls=http://localhost:5200
DownstreamUrls__Messaging=http://localhost:5300
DownstreamUrls__Recognition=http://localhost:3000

# ── Identity (:5104) ─────────────────────────────────────────────────────────
IDENTITY_URL=http://localhost:5104
ASPNETCORE_URLS__IDENTITY=http://localhost:5104

ConnectionStrings__DefaultConnection=Host=localhost;Database=SignTrack;Username=root;Password=admin;Port=5435

JwtSettings__SecretKey=CHANGE_ME_IN_USER_SECRETS_MIN_32_CHARS
JwtSettings__Issuer=AuthService
JwtSettings__Audience=AuthService
JwtSettings__ExpiryInMinutes=30

# ── Calls (:5200) ────────────────────────────────────────────────────────────
CALLS_URL=http://localhost:5200
ASPNETCORE_URLS__CALLS=http://localhost:5200

# ── Messaging (:5300) ────────────────────────────────────────────────────────
MESSAGING_URL=http://localhost:5300
ASPNETCORE_URLS__MESSAGING=http://localhost:5300

# ── Recognition (:3000) ────────────────────────────────────────────────────────
RECOGNITION_URL=http://localhost:3000
PORT=3000
PYTHON_EXECUTABLE=python

# Neon PostgreSQL (Recognition / ML dataset)
# NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
