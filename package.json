{
  "name": "SignTrack",
  "version": "2.0.0",
  "description": "SignTrack backend monorepo — microservicios C# + reconocimiento de señas (MediaPipe)",
  "type": "module",
  "scripts": {
    "recognition:api": "node services/recognition/src/api/server.js",
    "recognition:init-schema": "node services/recognition/src/db/initSchema.js",
    "recognition:backfill-r2": "node services/recognition/src/db/backfillFromR2.js",
    "recognition:export-letters": "node services/recognition/src/db/exportLetterDatasetFromNeon.js",
    "recognition:export-words": "node services/recognition/src/db/exportWordDatasetFromNeon.js",
    "recognition:process-dataset": "node services/recognition/src/db/processDataset.js",
    "recognition:letter-dataset": "python services/recognition/src/recognition/build_letter_dataset.py",
    "recognition:letter-train": "python services/recognition/src/model/train_model.py",
    "recognition:word-dataset": "python services/recognition/src/words/build_word_dataset.py",
    "recognition:word-train": "python services/recognition/src/words/train_word_model.py",
    "recognition:word-predict": "python services/recognition/src/words/predict_word.py",
    "recognition:eval-letters": "python services/recognition/src/model/evaluate_letters.py",
    "recognition:eval-words": "python services/recognition/src/words/evaluate_words.py",
    "recognition:camera": "python services/recognition/src/recognition/camera.py"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "dotenv": "^16.0.0",
    "express": "^5.2.1",
    "fs-extra": "^11.3.4",
    "pg": "^8.20.0"
  },
  "keywords": ["signtrack", "sign-language", "microservices"],
  "license": "ISC",
  "packageManager": "pnpm@10.29.3"
}
