{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=SignTrack;Username=root;Password=admin;Port=5435"
  },
  "JwtSettings": {
    "SecretKey": "CHANGE_ME_IN_USER_SECRETS_MIN_32_CHARS",
    "Issuer": "SignTrack.Identity",
    "Audience": "SignTrack.Identity",
    "ExpiryInMinutes": 60
  },
  "CloudinarySettings": {
    "CloudName": "YOUR_CLOUDINARY_CLOUD_NAME",
    "ApiKey": "YOUR_CLOUDINARY_API_KEY",
    "ApiSecret": "YOUR_CLOUDINARY_API_SECRET",
    "BaseUrl": "https://res.cloudinary.com/YOUR_CLOUDINARY_CLOUD_NAME/image/upload/",
    "DefaultAvatarPath": "default-avatar.png",
    "Folder": "signtrack/profiles"
  },
  "SmtpSettings": {
    "Host": "smtp.example.com",
    "Port": "465",
    "EnableSsl": "true",
    "Username": "YOUR_SMTP_USERNAME",
    "Password": "YOUR_SMTP_PASSWORD",
    "FromEmail": "noreply@signtrack.local",
    "FromName": "SignTrack",
    "Enabled": false,
    "Timeout": 30000,
    "UseFallback": false,
    "UseImplicitSsl": true
  },
  "AppSettings": {
    "FrontendUrl": "http://localhost:5180/signtrack"
  },
  "Security": {
    "AllowedOrigins": [
      "http://localhost:5180",
      "http://localhost:5173",
      "http://localhost:3000",
      "http://localhost:3001",
      "https://localhost:3000",
      "https://localhost:3001"
    ],
    "AdminAllowedOrigins": [
      "http://localhost:5180",
      "http://localhost:5173",
      "http://localhost:3000"
    ],
    "BlacklistedIPs": [],
    "WhitelistedIPs": [],
    "RestrictedPaths": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  }
}
