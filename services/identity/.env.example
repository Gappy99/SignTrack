# SignTrack.Identity — variables de entorno
#
# ASP.NET Core mapea __ (doble guion bajo) a secciones anidadas de appsettings.
# Copia este archivo a .env y ajusta los valores, o usa User Secrets en desarrollo:
#   dotnet user-secrets init --project AuthServiceSignTrack.Api
#   dotnet user-secrets set "JwtSettings:SecretKey" "tu-clave-secreta-min-32-chars" --project AuthServiceSignTrack.Api
#
# Entorno
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5104

# Base de datos (PostgreSQL)
ConnectionStrings__DefaultConnection=Host=localhost;Database=SignTrack;Username=postgres;Password=CHANGE_ME;Port=5435

# JWT
JwtSettings__SecretKey=CHANGE_ME_IN_USER_SECRETS_MIN_32_CHARS
JwtSettings__Issuer=AuthService
JwtSettings__Audience=AuthService
JwtSettings__ExpiryInMinutes=60

# Cloudinary (avatares de perfil)
CloudinarySettings__CloudName=YOUR_CLOUDINARY_CLOUD_NAME
CloudinarySettings__ApiKey=YOUR_CLOUDINARY_API_KEY
CloudinarySettings__ApiSecret=YOUR_CLOUDINARY_API_SECRET
CloudinarySettings__BaseUrl=https://res.cloudinary.com/YOUR_CLOUDINARY_CLOUD_NAME/image/upload/
CloudinarySettings__DefaultAvatarPath=default-avatar.png
CloudinarySettings__Folder=signtrack/profiles

# SMTP (correo de verificación / reset password)
SmtpSettings__Host=smtp.example.com
SmtpSettings__Port=465
SmtpSettings__EnableSsl=true
SmtpSettings__Username=YOUR_SMTP_USERNAME
SmtpSettings__Password=YOUR_SMTP_PASSWORD
SmtpSettings__FromEmail=noreply@signtrack.local
SmtpSettings__FromName=SignTrack
SmtpSettings__Enabled=false

# Frontend y CORS
AppSettings__FrontendUrl=http://localhost:5173
Security__AllowedOrigins__0=http://localhost:5173
Security__AllowedOrigins__1=http://localhost:3000
