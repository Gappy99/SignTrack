{
  "ServiceName": "SignTrack.Gateway",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "CHANGE_ME_IN_USER_SECRETS_MIN_32_CHARS",
    "Issuer": "SignTrack.Identity",
    "Audience": "SignTrack.Identity"
  },
  "DownstreamUrls": {
    "Identity": "http://localhost:5104",
    "Calls": "http://localhost:5200",
    "Messaging": "http://localhost:5300",
    "Recognition": "http://localhost:3000"
  }
}
