# Neon PostgreSQL
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Cloudflare R2
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://<public-domain>/

# Opcional: prefijo de objetos para backfill (ej. dataset/)
# R2_BACKFILL_PREFIX=
# BACKFILL_CONCURRENCY=5

# Python (ruta absoluta al intérprete con dependencias instaladas)
PYTHON_EXECUTABLE=python

# API HTTP
PORT=3000

# Opcional: coherencia / traducción con Gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_HYBRID_ENABLED=true
# GEMINI_HYBRID_CONFIDENCE_THRESHOLD=0.55
